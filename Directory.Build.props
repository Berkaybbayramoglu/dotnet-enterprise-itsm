<Project>
  <PropertyGroup>
    <SonarQubeCoverageExclusions>**/*.js,**/*.html,**/*.css,**/wwwroot/**,**/Migrations/**,**/DataSeeder.cs,**/Program.cs,**/ItsToolDbContextFactory.cs</SonarQubeCoverageExclusions>
    <SonarQubeDuplicationExclusions>**/*.js,**/*.html,**/*.css,**/wwwroot/**</SonarQubeDuplicationExclusions>
  </PropertyGroup>

  <ItemGroup>
    <SonarQubeSetting Include="sonar.cs.opencover.reportsPaths">
      <Value>$(MSBuildThisFileDirectory)tests/ItsTool.UnitTests/coverage.opencover.xml</Value>
    </SonarQubeSetting>
    <SonarQubeSetting Include="sonar.coverage.exclusions">
      <Value>**/*.js,**/*.html,**/*.css,**/wwwroot/**,**/Migrations/**,**/DataSeeder.cs,**/Program.cs,**/ItsToolDbContextFactory.cs</Value>
    </SonarQubeSetting>
    <SonarQubeSetting Include="sonar.cpd.exclusions">
      <Value>**/*.js,**/*.html,**/*.css,**/wwwroot/**</Value>
    </SonarQubeSetting>
    <SonarQubeSetting Include="sonar.exclusions">
      <Value>**/Migrations/**,**/bin/**,**/obj/**,**/coverage*.xml,**/uploads/**,**/*.pdf,**/*.jpeg,**/*.jpg,**/*.png,**/*.gif,**/*.svg,**/*.ico,**/wwwroot/**,**/*.html,**/*.js,**/*.css,src/ItsTool.Web/**,**/ItsToolDbContextFactory.cs</Value>
    </SonarQubeSetting>
    <SonarQubeSetting Include="sonar.sourceEncoding">
      <Value>UTF-8</Value>
    </SonarQubeSetting>
    <SonarQubeSetting Include="sonar.cs.roslyn.ignoreIssues">
      <Value>true</Value>
    </SonarQubeSetting>
  </ItemGroup>
</Project>
